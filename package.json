{
  "name": "global-realestate-dashboard",
  "version": "1.0.0",
  "description": "Global Real Estate Dashboard - Backend API with Express and SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node esbuild.config.mjs",
    "build:dev": "node esbuild.config.mjs --dev",
    "watch": "node esbuild.config.mjs --watch",
    "seed": "node server/db/seed.js",
    "scrape": "node server/scraper/run.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit --detectOpenHandles",
    "lint": "eslint server/ tools/ server.js",
    "lint:fix": "eslint server/ tools/ server.js --fix",
    "format": "prettier --write \"server/**/*.js\" \"tools/**/*.js\" server.js",
    "format:check": "prettier --check \"server/**/*.js\" \"tools/**/*.js\" server.js"
  },
  "keywords": [
    "real-estate",
    "dashboard",
    "express",
    "sqlite"
  ],
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  }
}
